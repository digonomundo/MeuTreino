<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    tools:context=".view.telaprincipal.ui.video.videoTreinos">


     <LinearLayout
         android:id="@+id/videoContainer"
         android:layout_width="match_parent"
         android:layout_height="240dp"
         android:orientation="vertical">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoSelecionado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="true" />

     </LinearLayout>

    <TextView
        android:id="@+id/txtVideoUnavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Ainda não há demonstração em vídeo para este exercício."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:orientation="vertical">

    <TextView
        android:id="@+id/txtDescVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:text=" "/>

    </ScrollView>

    </androidx.appcompat.widget.LinearLayoutCompat>
