<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeuTreino" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>

        <item name="materialCardViewStyle">@style/Widget.MeuTreino.CardView</item>
    </style>

    <style name="Theme.MeuTreino.NoActionBar" parent="Theme.MeuTreino">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MeuTreino.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="Theme.MeuTreino.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Widget.MeuTreino.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>

        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
